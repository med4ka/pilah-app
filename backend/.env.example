# Backend Pilah — Environment Variables
# Copy this file to `.env` and fill in every value.

# === REQUIRED (server fails fast if empty) ===

# Used to sign/verify JWT. Must not be empty (server will not start).
JWT_SECRET=

# Database connection — all five variables are required (read by database.go).
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change_me
DB_NAME=pilah_db

# === OPTIONAL (has a default/dev fallback) ===

# HTTP server port (default 8080).
PORT=8080

# Application mode: "production" enables the Secure flag on cookies.
# Any other value / empty = development.
APP_ENV=development

# Allowed CORS origins, comma-separated. If empty, dev fallback:
# http://localhost:3000, http://localhost:3001
ALLOWED_ORIGINS=

# Pinata JWT for IPFS evidence. If empty, IPFS pinning fails and is logged as
# an error (the main flow still works; only the proof is not recorded).
PINATA_JWT=
